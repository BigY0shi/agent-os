  "cards": [
    {
      "dot": "cyan",
      "title": "Two generations, one app",
      "items": [
        "V1 modules: flat components + route folders, JSON stores per module (Deal Desk, Hire Engine, Loop)",
        "V2 CORE on SQLite: agents runtime, memory, tasks, Jarvis brain, WebMCP, integrations",
        "Both live at once by design; nothing is migrated because it looks old"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "One password gate on 3737; the owner signs in, agents never hold credentials",
        "Keys leave through one door per module, server-side, host asserted in code",
        "Voicebox and Ollama are loopback; a chosen, labelled fallback is the only fallback"
      ]
    },
    {
      "dot": "amber",
      "title": "Open on the roadmap",
      "items": [
        "S2 runs survive navigation (registry + corner tray)",
        "S3 pre-launch settings drawer + STOP; S4 Deal Desk control",
        "S5 legacy memory backfill, S7 WebMCP wizard, S9 OpenMontage"
      ]
    }
